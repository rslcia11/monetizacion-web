# Response headers for static hosts that read this file (Cloudflare, Netlify).
# Comments must start the line: an indented "#" would be read as a header.
#
# HSTS: .dev is on the preload list already; the header covers every browser and subdomain too.
# COOP: clicking an ad opens the advertiser in a new tab, so popups must keep working.
# CSP: locks down what can't affect AdSense: no plugins, no <base> hijacking, forms post only to
# this site, nobody frames the site. Script and frame sources stay open for Google ads.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# Hashed build assets never change: cache them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The search index keeps the same file names between deploys: always revalidate.
/pagefind/*
  Cache-Control: public, max-age=0, must-revalidate
