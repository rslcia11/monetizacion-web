// Cloudflare deploy: the static site in dist/ served as Worker static assets.
// Build with `npm run build`, deploy with `npx wrangler deploy`. Steps: docs/despliegue.md
{
  "name": "kriterio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
