---
import { Image } from 'astro:assets';
import { toolInitials, toolLogo } from '../lib/tools';

interface Props {
  name: string;
  // Tile side in px.
  size: number;
  // Only for the initials fallback: solid = ink tile (main tool), outline = white tile with border.
  // A real logo always sits on a white tile, so its own colors stay intact.
  tone?: 'solid' | 'outline';
}

const { name, size, tone = 'solid' } = Astro.props;
const logo = toolLogo(name);
const radius = Math.round(size * 0.24);
const inner = Math.round(size * 0.62);
---

<span
  class:list={['tool-logo', logo ? 'has-logo' : tone]}
  style={{ width: `${size}px`, height: `${size}px`, borderRadius: `${radius}px`, fontSize: `${Math.round(size * 0.42)}px` }}
  aria-hidden="true"
>
  {logo ? <Image src={logo} alt="" width={inner} height={inner} /> : toolInitials(name)}
</span>

<style>
  .tool-logo {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    line-height: 1;
  }

  .solid {
    background: var(--ink);
    color: var(--paper);
  }

  .outline,
  .has-logo {
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--line-strong);
  }

  .tool-logo :global(img) {
    object-fit: contain;
  }
</style>
