---
import type { CollectionEntry } from 'astro:content';
import Avatar from '../Avatar.astro';
import { socialIcon } from '../../lib/social';
import { inLocale, localePath, t, type Locale } from '../../i18n/ui';

interface Props {
  author: CollectionEntry<'authors'>;
  locale: Locale;
  // "About the author" heading: on at the end of an article, off in the About page's list.
  showTitle?: boolean;
}

const { author, locale, showTitle = true } = Astro.props;
const headingId = `author-${author.id}`;
const { name, photo, links, stack } = author.data;
const role = inLocale(author.data.role, locale, `the role of author "${author.id}"`);
const bio = inLocale(author.data.bio, locale, `the bio of author "${author.id}"`);
---

<section class="author" aria-labelledby={headingId}>
  <Avatar name={name} photo={photo} size={72} ring="warm" alt={`${t(locale, 'author.photo')} ${name}`} />
  <div>
    {showTitle && <h2 class="title">{t(locale, 'author.title')}</h2>}
    <p class="name" id={headingId}>{name}, {role}</p>
    <p>{bio}</p>
    {
      stack.length > 0 && (
        <dl class="stack">
          {stack.map((group) => (
            <div>
              <dt>{inLocale(group.area, locale, `a stack area of author "${author.id}"`)}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      )
    }
    <div class="links">
      <a class="method" href={localePath(locale, 'how-we-test')}>{t(locale, 'footer.howWeTest')}</a>
      {
        links.map((link) => {
          const icon = socialIcon(link.url);
          return icon ? (
            <a class="profile" href={link.url} rel="me noopener" aria-label={`${name} ${t(locale, 'author.on')} ${link.label}`} title={link.label}>
              <svg viewBox="0 0 24 24" width="20" height="20" fill={icon.color} aria-hidden="true">
                <path d={icon.path} />
              </svg>
            </a>
          ) : (
            <a class="method" href={link.url} rel="me noopener">
              {link.label}
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .author {
    display: flex;
    gap: 20px;
    padding: 24px;
    background: var(--warm-soft);
    border-radius: var(--radius-lg);
    font-size: 16px;
    line-height: 1.55;
  }

  .title {
    margin-bottom: 6px;
    font-family: var(--font-sans);
    font-size: 17px;
  }

  .name {
    font-weight: 600;
  }

  .name + p {
    margin-top: 4px;
  }

  .stack {
    display: grid;
    gap: 6px;
    margin-top: 14px;
    font-size: 15px;
  }

  .stack div {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 12px;
  }

  .stack dt {
    font-weight: 600;
  }

  .stack dd {
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 15px;
    font-weight: 600;
  }

  .method {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-right: 12px;
  }

  /* Profile buttons: brand glyph on a white disc, brand-colored ring on hover. */
  .profile {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--warm-line);
    border-radius: 50%;
    background: var(--paper);
  }

  .profile:hover {
    border-color: var(--ink);
  }

  @media (max-width: 640px) {
    .author {
      flex-direction: column;
      padding: 20px;
    }

    .stack div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
