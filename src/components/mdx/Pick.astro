---
import ToolLogo from '../ToolLogo.astro';
import { t, toLocale } from '../../i18n/ui';

interface Props {
  tool: string;
  // One line: who it is for and why.
  why: string;
  // Anchor of the tool's section in this article, e.g. "#bruno-keeps-your-requests-in-the-repo".
  // Checked at build time against the article's headings.
  href: `#${string}`;
  // Short use case shown above the name, e.g. "Nothing to install". Not shown on the top pick.
  label?: string;
  top?: boolean;
}

const { tool, why, href, label, top = false } = Astro.props;
const locale = toLocale(Astro.currentLocale);

if (!top && !label) {
  throw new Error(`<Pick tool="${tool}">: add a label (the use case it wins), or mark it as top.`);
}
---

<div class:list={['pick', { top }]}>
  <ToolLogo name={tool} size={60} tone={top ? 'solid' : 'outline'} />
  <div class="body">
    {top ? <p class="badge">{t(locale, 'picks.top')}</p> : <p class="use-case">{label}</p>}
    <p class="name">{tool}</p>
    <p class="why">{why}</p>
  </div>
  <a class:list={['button', { filled: top }]} href={href}>
    {t(locale, 'picks.read')}<span class="visually-hidden">: {tool}</span>
  </a>
</div>

<style>
  .pick {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 24px;
  }

  .top {
    background: var(--warm-soft);
  }

  .body {
    flex-grow: 1;
    min-width: 0;
  }

  .badge {
    display: inline-block;
    padding: 2px 10px;
    background: var(--warm);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }

  .use-case {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent);
  }

  .name {
    margin-top: 4px;
    font-size: 21px;
    font-weight: 700;
    line-height: 1.3;
  }

  .why {
    margin-top: 2px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .button {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 19px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-sm);
    font-size: 15px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .button:hover {
    background: var(--accent-soft);
    color: var(--accent-hover);
  }

  .button.filled {
    background: var(--accent);
    color: var(--paper);
  }

  .button.filled:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--paper);
  }

  @media (max-width: 640px) {
    .pick {
      flex-wrap: wrap;
      padding: 20px;
      gap: 14px 16px;
    }

    .body {
      flex-basis: calc(100% - 76px);
    }

    .button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
