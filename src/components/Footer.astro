---
import Logo from './Logo.astro';
import { cookiesSection, sitePages } from '../lib/routes';
import { site } from '../lib/site';
import { localePath, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// Set when the page is built: a yearly rebuild (or any new article) keeps it current.
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <Logo href={localePath(locale)} size="sm" />
      <p>{t(locale, 'site.tagline')}</p>
      <p class="copyright">© {year} {site.name}</p>
    </div>
    <nav class="links" aria-label={t(locale, 'nav.footer')}>
      {sitePages.map((page) => <a href={localePath(locale, page.slug)}>{t(locale, page.label)}</a>)}
      <a href={`${localePath(locale, cookiesSection.page)}#${cookiesSection.anchor}`}>{t(locale, 'footer.cookies')}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  .inner {
    padding-block: 44px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    font-size: 15px;
  }

  .about {
    max-width: 420px;
    line-height: 1.55;
  }

  .about > :global(.logo) {
    margin-bottom: 6px;
  }

  .copyright {
    margin-top: 12px;
    font-size: 14px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-2);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .inner {
      flex-direction: column;
      gap: 20px;
    }
  }
</style>
