---
import { localePath, t, type Locale } from '../i18n/ui';

// Plain GET form to the search page: works before any JavaScript loads (DESIGN.md 4, "Buscador").
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<form class="search" role="search" action={localePath(locale, 'search')} method="get">
  <label class="visually-hidden" for="search-q">{t(locale, 'search.label')}</label>
  <input
    id="search-q"
    type="search"
    name="q"
    placeholder={t(locale, 'search.placeholder')}
    autocomplete="off"
    enterkeyhint="search"
    required
  />
  <button type="submit" aria-label={t(locale, 'nav.search')}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
      <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
    </svg>
  </button>
</form>

<style>
  .search {
    position: relative;
    width: 100%;
    max-width: 460px;
  }

  input {
    width: 100%;
    height: 50px;
    padding: 0 58px 0 22px;
    border: 1px solid var(--field-line);
    border-radius: 25px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-size: 16px;
  }

  input::placeholder {
    color: var(--pending);
  }

  input:focus-visible {
    outline-offset: 2px;
    border-color: var(--accent);
  }

  button {
    position: absolute;
    top: 3px;
    right: 3px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: var(--paper);
    cursor: pointer;
  }

  button:hover {
    background: var(--accent-hover);
  }
</style>
