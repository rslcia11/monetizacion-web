---
import { adUnit, type AdPlacement } from '../lib/ads';
import { t, toLocale } from '../i18n/ui';

interface Props {
  placement: AdPlacement;
}

const { placement } = Astro.props;
const unit = adUnit(placement);
const locale = toLocale(Astro.currentLocale);

// Fixed height reserved before the ad loads, so the page doesn't jump (CLS, DESIGN.md 4).
const format = placement === 'home' ? 'horizontal' : placement === 'sidebar' ? 'vertical' : 'auto';
---

{
  unit && (
    <aside class:list={['ad', placement]} aria-label={t(locale, 'ad.label')}>
      <p class="label">{t(locale, 'ad.label')}</p>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={unit.client}
        data-ad-slot={unit.slot}
        data-ad-format={format}
        data-full-width-responsive={placement === 'sidebar' ? 'false' : 'true'}
      ></ins>
      {/* Only request an ad for a visible slot: the sidebar is hidden below 1024px, and a
          zero-width slot makes AdSense throw and requests an ad nobody can see. */}
      <script is:inline>
        (function (ins) {
          if (ins && ins.offsetWidth > 0) (window.adsbygoogle = window.adsbygoogle || []).push({});
        })(document.currentScript.previousElementSibling);
      </script>
    </aside>
  )
}

<style>
  .ad {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8px;
    background: var(--surface);
    border-radius: var(--radius-md);
  }

  .label {
    margin-bottom: 6px;
    font-size: 13px;
    color: var(--pending);
    text-align: center;
  }

  .article {
    min-height: 250px;
  }

  .sidebar {
    min-height: 600px;
  }

  .home {
    min-height: 120px;
  }
</style>
