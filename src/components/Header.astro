---
import Logo from './Logo.astro';
import { kindsWithArticles } from '../lib/articles';
import { kindEntries } from '../lib/kinds';
import { localeMeta, localePath, t, type Alternate, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  // Only rendered when this page really exists in the other language.
  otherLanguage?: Alternate;
}

const { locale, otherLanguage } = Astro.props;
const current = Astro.url.pathname;
// Empty sections stay out of the menu until they have articles.
const available = await kindsWithArticles(locale);

const links = [
  { href: localePath(locale), label: t(locale, 'nav.latest') },
  ...kindEntries
    .filter(([kind]) => available.has(kind))
    .map(([, info]) => ({ href: localePath(locale, info.slug), label: t(locale, info.label) })),
];
---

<header class="site-header">
  <div class="bar">
    <Logo href={localePath(locale)} tone="dark" />
    <nav class="nav" aria-label={t(locale, 'nav.main')}>
      {
        links.map((link) => (
          <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    {
      available.size > 0 && (
        <a class="search-link" href={localePath(locale, 'search')} aria-label={t(locale, 'nav.search')}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" />
            <path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
          </svg>
        </a>
      )
    }
    {
      otherLanguage && (
        <a class="language" href={otherLanguage.href} hreflang={otherLanguage.locale} lang={otherLanguage.locale}>
          {localeMeta[otherLanguage.locale].label}
        </a>
      )
    }
  </div>
</header>

<style>
  /* Teal brand bar (DESIGN.md 4). Spans the full width so the logo sits near the left edge;
     the page content below stays centered in its 1120px column. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--accent);
    color: var(--paper);
  }

  .bar {
    max-width: 1440px;
    min-height: var(--header-h);
    margin-inline: auto;
    padding-inline: 40px;
    display: flex;
    align-items: center;
    gap: 44px;
  }

  .nav {
    display: flex;
    gap: 28px;
    flex-grow: 1;
    font-size: 15px;
    font-weight: 500;
  }

  .nav a,
  .language {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--paper);
    text-decoration: none;
    text-underline-offset: 8px;
    text-decoration-thickness: 3px;
  }

  .nav a:hover,
  .language:hover {
    color: var(--paper);
    text-decoration-line: underline;
    text-decoration-color: rgb(255 255 255 / 55%);
  }

  /* Current page: warm underline (yellow = highlight in the palette). */
  .nav a[aria-current='page'] {
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--warm);
  }

  .language {
    font-size: 15px;
  }

  .search-link {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--paper);
  }

  .search-link:hover {
    color: var(--paper);
    background: rgb(255 255 255 / 14%);
  }

  /* The global focus ring is teal: invisible on this bar. */
  .site-header :focus-visible {
    outline-color: var(--paper);
  }

  @media (max-width: 760px) {
    .bar {
      flex-wrap: wrap;
      gap: 0 24px;
      padding-inline: var(--gutter);
      padding-top: 6px;
    }

    .bar > :global(.logo) {
      flex-grow: 1;
    }

    /* Nav drops to its own row and scrolls sideways instead of hiding behind a menu button. */
    .nav {
      order: 3;
      flex-basis: 100%;
      gap: 22px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav a {
      white-space: nowrap;
    }
  }
</style>
