---
import ArticleCover from './ArticleCover.astro';
import { articleUrl, type Article } from '../lib/articles';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, topic, tools, kind, hook } = article.data;
---

<a class="card" href={articleUrl(article)} data-card-topic={topic}>
  <ArticleCover tools={tools} kind={kind} hook={hook} />
  <p class="topic-label">{topic}</p>
  <h3 class="title">{title}</h3>
  <p class="summary">{description}</p>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    color: var(--ink);
    text-decoration: none;
    /* Cards below the fold skip layout and paint until scrolled near: less work on slow phones.
       The size hint keeps the scrollbar stable; "auto" remembers the real size once rendered. */
    content-visibility: auto;
    contain-intrinsic-size: auto 420px;
  }

  /* Hidden by the topic filter. */
  .card[hidden] {
    display: none;
  }

  .card :global(.cover) {
    margin-bottom: 16px;
  }

  .topic-label {
    margin-bottom: 6px;
  }

  .title {
    margin-bottom: 8px;
    font-size: 20px;
    line-height: 1.3;
    font-weight: 700;
  }

  .card:hover .title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .summary {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }
</style>
