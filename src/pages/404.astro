---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, t } from '../i18n/ui';

const locale = 'en';
---

<BaseLayout locale={locale} title={t(locale, 'notFound.title')} description={t(locale, 'notFound.body')}>
  <main class="container not-found">
    <h1>{t(locale, 'notFound.title')}</h1>
    <p>{t(locale, 'notFound.body')}</p>
    <p><a href={localePath(locale)}>{t(locale, 'notFound.home')}</a></p>
  </main>
</BaseLayout>

<style>
  .not-found {
    padding-block: 72px 96px;
    max-width: var(--measure);
  }

  h1 {
    margin-bottom: 16px;
    font-size: 36px;
  }

  p + p {
    margin-top: 12px;
  }
</style>
