---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorBox from '../components/article/AuthorBox.astro';
import { mdxComponents } from '../components/mdx';
import { localeFromId, slugFromId } from '../lib/articles';
import type { SitePage } from '../lib/pages';
import { formatDate, sharedAlternates, t } from '../i18n/ui';

interface Props {
  page: SitePage;
}

const { page } = Astro.props;
const locale = localeFromId(page.id);
const { title, description, updatedAt, showAuthors } = page.data;
const { Content } = await render(page);
const authors = showAuthors ? await getCollection('authors') : [];
---

<BaseLayout locale={locale} title={title} description={description} alternates={sharedAlternates(slugFromId(page.id))}>
  <main class="container page">
    <h1>{title}</h1>
    <p class="updated">
      {t(locale, 'page.updated')}: <time datetime={updatedAt.toISOString()}>{formatDate(locale, updatedAt)}</time>
    </p>
    <div class="prose">
      <Content components={mdxComponents} />
    </div>
    {
      authors.length > 0 && (
        <section class="authors" aria-labelledby="authors-title">
          <h2 id="authors-title" class="section-heading">
            {t(locale, 'page.authors')}
          </h2>
          {authors.map((author) => (
            <AuthorBox author={author} locale={locale} showTitle={false} />
          ))}
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .page {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    padding-block: 44px 72px;
  }

  h1 {
    margin-bottom: 8px;
    font-size: 40px;
    line-height: 1.15;
  }

  .updated {
    margin-bottom: 36px;
    font-size: 15px;
    color: var(--muted);
  }

  .authors {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 56px;
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 32px;
    }
  }
</style>
