---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Avatar from '../components/Avatar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AdSlot from '../components/AdSlot.astro';
import HowWeTested from '../components/article/HowWeTested.astro';
import Sources from '../components/article/Sources.astro';
import AuthorBox from '../components/article/AuthorBox.astro';
import { mdxComponents } from '../components/mdx';
import { alternatesFor, articleLocale, articleSlug, type Article } from '../lib/articles';
import { kinds } from '../lib/kinds';
import { absoluteUrl, organizationJsonLd } from '../lib/site';
import { formatDate, inLocale, localePath, t } from '../i18n/ui';

interface Props {
  article: Article;
  // Every published article, to find this one's translations.
  all: Article[];
}

const { article, all } = Astro.props;
const locale = articleLocale(article);
const { title, description, lede, kind, topic, publishedAt, updatedAt, testedAt, method, testing, sources } = article.data;
const researched = method === 'research';
const { Content, headings } = await render(article);
const author = await getEntry(article.data.author);
if (!author) {
  throw new Error(`Article "${article.id}": author "${article.data.author.id}" not found in src/content/authors/.`);
}

const kindInfo = kinds[kind];
const kindLabel = t(locale, kindInfo.label);
const kindHref = localePath(locale, kindInfo.slug);
// Same source as BaseLayout's canonical, so both always agree.
const url = absoluteUrl(Astro.url.pathname);

// Sections every article gets from its frontmatter, after the body. Fixed ids in every language.
const autoSections = [
  { depth: 2, slug: 'how-we-tested', text: t(locale, researched ? 'research.title' : 'testing.title') },
  { depth: 2, slug: 'sources', text: t(locale, 'sources.title') },
];
const toc = [...headings.filter((h) => h.depth === 2), ...autoSections];

// Build-time checks on the body: broken in-page links and ads above the picks fail the build.
const body = article.body ?? '';
const slug = articleSlug(article);
const ids = new Set([...headings.map((h) => h.slug), ...autoSections.map((s) => s.slug)]);
for (const s of autoSections) {
  if (headings.some((h) => h.slug === s.slug)) {
    throw new Error(`Article "${slug}": don't write a "${s.text}" heading, it is generated from the frontmatter.`);
  }
}
for (const [, anchor] of body.matchAll(/href="#([^"]+)"/g)) {
  if (!ids.has(anchor)) {
    throw new Error(`Article "${slug}": link to "#${anchor}" has no matching heading.`);
  }
}
// Ad rules (DESIGN.md 4, Better Ads Standards): at most 3 in-content ads, never back to back,
// and never between the title and the verdict (<Picks>, or the first section without picks).
const MAX_IN_CONTENT_ADS = 3;
const ads = [...body.matchAll(/<Ad\b[^>]*\/>/g)].map((m) => ({ start: m.index, end: m.index + m[0].length }));
if (ads.length > MAX_IN_CONTENT_ADS) {
  throw new Error(`Article "${slug}": ${ads.length} <Ad /> blocks; the limit is ${MAX_IN_CONTENT_ADS}.`);
}
if (ads.some((ad, i) => i > 0 && body.slice(ads[i - 1].end, ad.start).trim() === '')) {
  throw new Error(`Article "${slug}": two <Ad /> blocks in a row. Put content between them.`);
}
const picks = body.indexOf('<Picks');
const adsAllowedFrom = picks !== -1 ? picks : body.search(/^## /m);
if (ads.length > 0 && (adsAllowedFrom === -1 || ads[0].start < adsAllowedFrom)) {
  throw new Error(`Article "${slug}": ads can't go above "Our picks" or the first section (DESIGN.md 4).`);
}

// Article + BreadcrumbList (plan 9.5). No FAQ schema: Google stopped showing FAQ rich results.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    inLanguage: locale,
    datePublished: publishedAt.toISOString(),
    dateModified: updatedAt.toISOString(),
    // Google asks for 16:9, 4:3 and 1:1 versions, at least 1200 px wide (Article and Discover docs).
    image: ['16x9', '4x3', '1x1'].map((shape) => absoluteUrl(`/og/${article.id}-${shape}.png`)),
    author: {
      '@type': 'Person',
      name: author.data.name,
      url: absoluteUrl(localePath(locale, 'about')),
      // Public profiles tie the byline to a real person (E-E-A-T).
      sameAs: author.data.links.map((link) => link.url),
    },
    publisher: organizationJsonLd(),
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: kindLabel, item: absoluteUrl(kindHref) },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  alternates={alternatesFor(article, all)}
  ogType="article"
  ogImage={`/og/${article.id}.png`}
  jsonLd={jsonLd}
>
  <!-- Search index (Pagefind): only the article itself, not navigation, ads or the author box. -->
  <main id="main" data-pagefind-body>
  <div class="article-head">
    <div class="container">
      <nav class="breadcrumb" aria-label={t(locale, 'nav.breadcrumb')}>
        <a href={kindHref}>{kindLabel}</a> / <span data-pagefind-meta="topic">{topic}</span>
      </nav>
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <div class="byline" data-pagefind-ignore>
        <Avatar name={author.data.name} photo={author.data.photo} size={48} ring="accent" />
        <div>
          <p>
            <a class="author" href={localePath(locale, 'about')}>{author.data.name}</a>,{' '}
            {inLocale(author.data.role, locale, `the role of author "${author.id}"`)}
          </p>
          <p class="dates">
          {t(locale, researched ? 'article.researched' : 'article.tested')} <time datetime={testedAt.toISOString()}>{formatDate(locale, testedAt)}</time>.{' '}
          {t(locale, 'article.updated')} <time datetime={updatedAt.toISOString()}>{formatDate(locale, updatedAt)}</time>.{' '}
          {t(locale, 'article.independence')}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="container layout">
    <div class="content">
      <TableOfContents headings={toc} locale={locale} variant="inline" />
      <div class="prose">
        <Content components={mdxComponents} />
      </div>
      <div class="after" data-pagefind-ignore>
        <HowWeTested id="how-we-tested" locale={locale} testing={testing} testedAt={testedAt} method={method} />
        <Sources id="sources" locale={locale} sources={sources} />
        <AuthorBox author={author} locale={locale} />
      </div>
    </div>
    <aside class="sidebar" data-pagefind-ignore>
      <TableOfContents headings={toc} locale={locale} variant="sidebar" />
      <div class="sidebar-ad">
        <AdSlot placement="sidebar" />
      </div>
    </aside>
  </div>
  </main>
</BaseLayout>

<style>
  .article-head {
    background: var(--accent-soft);
    padding-block: 44px 48px;
  }

  .breadcrumb {
    margin-bottom: 16px;
    font-size: 15px;
    color: var(--muted);
  }

  .breadcrumb a {
    color: var(--ink);
  }

  h1 {
    max-width: 840px;
    margin-bottom: 18px;
    font-size: 48px;
    line-height: 1.12;
  }

  .lede {
    max-width: var(--measure);
    margin-bottom: 28px;
    font-size: 20px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
    line-height: 1.45;
  }

  .author {
    font-weight: 600;
    color: var(--ink);
  }

  .after {
    display: flex;
    flex-direction: column;
    gap: 56px;
    margin-top: 56px;
  }

  .dates {
    color: var(--muted);
  }

  /* 720 + 52 + 300 = 1072 = container minus gutters. */
  .layout {
    display: flex;
    gap: 52px;
    align-items: flex-start;
    padding-block: 48px 72px;
  }

  .content {
    width: var(--measure);
    min-width: 0;
    flex-shrink: 1;
  }

  /* Stretches to the article's height so the ad inside can stay in view while reading.
     AdSense sticky rules: one sticky ad, desktop only, max 300px wide, never over content. */
  .sidebar {
    width: var(--sidebar);
    flex-shrink: 0;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Sticky only when the whole unit (~640px + 100px offset) fits the screen: on shorter
     laptops a stuck ad would stay half cut off. */
  @media (min-height: 760px) {
    .sidebar-ad {
      position: sticky;
      top: 100px;
    }
  }

  /* Below the full desktop width: one column, no sidebar and no sticky ad (tablets included). */
  @media (max-width: 1119px) {
    .layout {
      display: block;
    }

    .content {
      width: auto;
      max-width: var(--measure);
    }

    .sidebar {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    h1 {
      font-size: 38px;
    }
  }

  @media (max-width: 640px) {
    .article-head {
      padding-block: 28px 32px;
    }

    h1 {
      font-size: 32px;
      line-height: 1.15;
    }

    .lede {
      font-size: 18px;
    }

  }
</style>
