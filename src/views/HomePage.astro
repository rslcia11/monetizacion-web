---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import SearchForm from '../components/SearchForm.astro';
import TopicFilter from '../components/TopicFilter.astro';
import { getArticles } from '../lib/articles';
import { absoluteUrl, organizationJsonLd, site } from '../lib/site';
import { sharedAlternates, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const articles = await getArticles(locale);
// The feature rotates through every article, so the grid below lists all of them too.
const featured = articles.length > 0;
// Filter buttons only make sense with at least two topics to choose from.
const topics = [...new Set(articles.map((a) => a.data.topic))].sort((a, b) => a.localeCompare(b, locale));

// Tells search engines what the site is and who publishes it.
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: absoluteUrl(Astro.url.pathname), inLanguage: locale },
  { '@context': 'https://schema.org', ...organizationJsonLd() },
];

// Principle: "come in, see articles, done". No marketing hero (plan 9.4).
---

<BaseLayout
  locale={locale}
  title={t(locale, 'home.title')}
  brandFirst
  description={t(locale, 'home.description')}
  alternates={sharedAlternates()}
  jsonLd={jsonLd}
>
  <main id="main" class="container home">
    <div class="home-head">
      <div class="home-intro">
        <h1 class="home-title">{t(locale, 'home.title')}</h1>
        <p class="home-lede">{t(locale, 'home.intro')}</p>
      </div>
      {featured && <SearchForm locale={locale} />}
    </div>

    {featured && <FeaturedCarousel articles={articles} locale={locale} />}

    {!featured && <p class="empty">{t(locale, 'home.empty')}</p>}

    {
      articles.length > 0 && (
        <section class="latest" aria-labelledby="latest">
          <h2 id="latest" class="section-title">{t(locale, 'home.latest')}</h2>
          {topics.length > 1 && <TopicFilter topics={topics} locale={locale} />}
          <ArticleGrid articles={articles} emptyText={t(locale, 'home.empty')} />
        </section>
      )
    }

    {featured && <AdSlot placement="home" />}
  </main>
</BaseLayout>

<style>
  .home {
    padding-block: 36px 72px;
  }

  .home-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-bottom: 32px;
  }

  .home-title {
    font-size: 30px;
  }

  .home-intro {
    flex: 1 1 600px;
    max-width: 740px;
  }

  .home-lede {
    margin-top: 10px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-2);
  }

  .empty {
    color: var(--muted);
  }

  .home :global(.ad) {
    margin-top: 48px;
  }

  .section-title {
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    font-size: 26px;
  }
</style>
