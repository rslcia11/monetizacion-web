---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchForm from '../components/SearchForm.astro';
import { sharedAlternates, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<!-- Internal search results stay out of Google (noindex) and the sitemap. -->
<BaseLayout
  locale={locale}
  title={t(locale, 'search.title')}
  description={t(locale, 'search.description')}
  alternates={sharedAlternates('search')}
  noindex
>
  <main id="main" class="container search-page">
    <h1>{t(locale, 'search.title')}</h1>
    <SearchForm locale={locale} />
    <div
      class="output"
      data-search
      data-loading={t(locale, 'search.loading')}
      data-count-one={t(locale, 'search.countOne')}
      data-count={t(locale, 'search.count')}
      data-none={t(locale, 'search.none')}
      data-unavailable={t(locale, 'search.unavailable')}
    >
      <p class="status" role="status"></p>
      <ol class="results"></ol>
    </div>
  </main>
</BaseLayout>

<script>
  // Index built by Pagefind after `astro build` (package.json). It doesn't exist in `astro dev`,
  // so there the page shows the "unavailable" message.
  type Result = { url: string; excerpt: string; meta: { title?: string; topic?: string } };

  const output = document.querySelector<HTMLElement>('[data-search]')!;
  const input = document.querySelector<HTMLInputElement>('#search-q')!;
  const status = output.querySelector('.status')!;
  const list = output.querySelector('.results')!;
  const text = output.dataset as Record<string, string>;
  const query = new URLSearchParams(location.search).get('q')?.trim() ?? '';

  const message = (template: string, count = 0) =>
    template.replace('{query}', query).replace('{count}', String(count));

  // Pagefind marks matches with <mark>. The excerpt is parsed in an inert <template> and only
  // its text and <mark> tags are copied, so no other HTML from the index reaches the page.
  function excerptParagraph(excerpt: string) {
    const template = document.createElement('template');
    template.innerHTML = excerpt;
    const paragraph = document.createElement('p');
    paragraph.className = 'excerpt';
    for (const node of template.content.childNodes) {
      if (node.nodeName === 'MARK') {
        const mark = document.createElement('mark');
        mark.textContent = node.textContent;
        paragraph.append(mark);
      } else {
        paragraph.append(node.textContent ?? '');
      }
    }
    return paragraph;
  }

  function render(results: Result[]) {
    list.replaceChildren(
      ...results.map((result) => {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = result.url;
        link.textContent = result.meta.title ?? result.url;
        item.append(link);
        if (result.meta.topic) {
          const topic = document.createElement('p');
          topic.className = 'topic-label';
          topic.textContent = result.meta.topic;
          item.prepend(topic);
        }
        item.append(excerptParagraph(result.excerpt));
        return item;
      }),
    );
  }

  async function search() {
    input.value = query;
    if (!query) return;
    status.textContent = text.loading;
    try {
      const url = '/pagefind/pagefind.js';
      const pagefind = await import(/* @vite-ignore */ url);
      const { results } = await pagefind.search(query);
      const data: Result[] = await Promise.all(results.slice(0, 20).map((r: { data: () => Promise<Result> }) => r.data()));
      status.textContent =
        results.length === 0 ? message(text.none) : message(results.length === 1 ? text.countOne : text.count, results.length);
      render(data);
    } catch {
      status.textContent = text.unavailable;
    }
  }

  search();
</script>

<style>
  .search-page {
    padding-block: 36px 72px;
    max-width: var(--measure);
  }

  h1 {
    margin-bottom: 20px;
    font-size: 30px;
  }

  .status {
    margin-block: 24px 8px;
    color: var(--muted);
  }

  .results {
    padding: 0;
    list-style: none;
  }

  .results :global(li) {
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }

  .results :global(.topic-label) {
    margin-bottom: 4px;
  }

  .results :global(a) {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
  }

  .results :global(.excerpt) {
    margin-top: 6px;
    font-size: 16px;
    color: var(--muted);
  }

  .results :global(mark) {
    background: var(--warm-soft);
    color: var(--ink);
    font-weight: 600;
  }
</style>
